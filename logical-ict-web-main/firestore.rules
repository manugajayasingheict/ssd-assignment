rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------
    // Users
    // --------------------------
    match /users/{userId} {
      function isAdmin() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      }

      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // A student's initial verification value must match Firebase Auth.
      allow create: if request.auth != null
        && (
          (
            request.auth.uid == userId
            && request.resource.data.role == "student"
            && request.resource.data.isVerified == request.auth.token.email_verified
          )
          || (
            request.auth.uid != userId
            && isAdmin()
          )
        );

      // Students may edit ordinary profile fields,
      // but cannot modify authorization/verification fields.
      allow update: if request.auth != null
        && (
          (
            request.auth.uid == userId
            && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(["isVerified", "role", "batch"])
          )
          || (
            request.auth.uid != userId
            && isAdmin()
          )
        );

      allow delete: if isAdmin();
    }

    // --------------------------
    // Batches
    // --------------------------
    match /batches/{batchId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // --------------------------
    // Enrollments
    // Member 2 security fixes
    // --------------------------
    match /enrollments/{docId} {

      // Students can create only their own enrollment
      // and it must start as pending.
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == "pending";

      // Students can read only their own enrollments;
      // admins can read all.
      allow read: if request.auth != null &&
        (
          request.auth.uid == resource.data.studentId
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
          )
        );

      // Students may update only their own non-sensitive
      // enrollment fields.
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.studentId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.batch == resource.data.batch &&
        request.resource.data.className == resource.data.className &&
        request.resource.data.month == resource.data.month &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["slipPath", "whatsappNumber", "updatedAt"]);

      // Admin may update status only from pending
      // to approved or rejected.
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
        request.resource.data.studentId == resource.data.studentId &&
        (
          request.resource.data.status == resource.data.status
          || (
            resource.data.status == "pending" &&
            request.resource.data.status in ["approved", "rejected"]
          )
        );

      // No one can delete enrollments.
      allow delete: if false;
    }

    // --------------------------
    // Notifications
    // --------------------------
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        // Admins can read all notifications.
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ||
        // Students can read their own batch or "all".
        (
          resource.data.keys().hasAll(['batch']) &&
          (
            resource.data.batch == "all"
            || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.batch
                == resource.data.batch
            )
          )
        )
      );

      // Only admins can create or update notifications.
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      // No one can delete notifications.
      allow delete: if false;
    }

    // --------------------------
    // Catch-all: deny everything else
    // --------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}