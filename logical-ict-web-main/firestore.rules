rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------
    // Users: students can read/write their own profile, admin can read/write all
    // --------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        (
          request.auth.uid == userId
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
        );
    }

    // --------------------------
    // Batches: students can read, only admin can write
    // --------------------------
    match /batches/{batchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // --------------------------
    // Enrollments: students can create/read their own; status changes are admin-only
    // --------------------------
    match /enrollments/{docId} {

      // Students can create only their own enrollment and it must start as pending
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == "pending";

      // Students can read only their own enrollments; admin can read all
      allow read: if request.auth != null &&
        (
          request.auth.uid == resource.data.studentId
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
        );

      // Students may update their own enrollment only when they keep the same status
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.studentId &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == resource.data.status;

      // Admin may update status only from pending to approved or rejected
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
        request.resource.data.studentId == resource.data.studentId &&
        (
          request.resource.data.status == resource.data.status
          || (
            resource.data.status == "pending" &&
            request.resource.data.status in ["approved", "rejected"]
          )
        );

      // No one can delete enrollments
      allow delete: if false;
    }

    // --------------------------
    // Notifications: students see only their batch or 'all'; admin can create/update all
    // --------------------------
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        // Admins can read all notifications
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ||
        // Students: batch field must exist and match theirs, or be 'all'
        (
          resource.data.keys().hasAll(['batch']) &&
          (
            resource.data.batch == "all"
            || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.batch == resource.data.batch
            )
          )
        )
      );

      // Only admin can create or update notifications
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      // No one can delete notifications
      allow delete: if false;
    }

    // --------------------------
    // Catch-all: deny access to any other document
    // --------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
