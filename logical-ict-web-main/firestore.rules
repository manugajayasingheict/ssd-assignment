rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------
    // Users: students can read/write their own profile, admin can read/write all
    // --------------------------
    match /users/{userId} {

  // Users can read their own profile.
  // Admins can read any user profile.
  allow read: if request.auth != null &&
    (
      request.auth.uid == userId
      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
    );

  // A new user can only create their own profile as a student.
  allow create: if request.auth != null &&
    request.auth.uid == userId &&
    (
      !request.resource.data.keys().hasAny(['role'])
      || request.resource.data.role == "student"
    );

  // Students can update their own profile, but cannot change their role.
  allow update: if request.auth != null &&
    (
      (
        request.auth.uid == userId &&
        request.resource.data.batch == resource.data.batch &&
        request.resource.data.diff(resource.data).affectedKeys().hasNone([
          'authProvider',
          'providerEmail',
          'providerEmailVerified'
        ]) &&
        (
          (
            resource.data.keys().hasAny(['role']) &&
            request.resource.data.role == resource.data.role
            )
            ||
            (
              !resource.data.keys().hasAny(['role']) &&
              request.resource.data.role == "student"
              )
)
      )
      ||
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
    );

  // No other writes.
  allow delete: if request.auth != null &&
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
}

    // --------------------------
    // Batches: students can read, only admin can write
    // --------------------------
    match /batches/{batchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // --------------------------
    // Enrollments: students can create/read/update their own (if not approved), admin can read/update all
    // --------------------------
    match /enrollments/{docId} {

      // Any authenticated user can create their own enrollment
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid;

      // Students can read only their own enrollments; admin can read all
      allow read: if request.auth != null &&
        (
          request.auth.uid == resource.data.studentId
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
        );

      // Students can update their own enrollment only if status is not "approved"
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.studentId &&
        resource.data.status != "approved";

      // Admin can update any enrollment
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      // No one can delete enrollments
      allow delete: if false;
    }

    // --------------------------
    // Notifications: students see only their batch or 'all'; admin can create/update all
    // --------------------------
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        // Admins can read all notifications
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ||
        // Students: batch field must exist and match theirs, or be 'all'
        (
          resource.data.keys().hasAll(['batch']) &&
          (
            resource.data.batch == "all"
            || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.batch == resource.data.batch
            )
          )
        )
      );

      // Only admin can create or update notifications
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      // No one can delete notifications
      allow delete: if false;
    }

    // --------------------------
    // Catch-all: deny access to any other document
    // --------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
